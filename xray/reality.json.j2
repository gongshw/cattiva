{
  "log": { "loglevel": "warning" },
  "inbounds": [{
    "port": 4433,
    "protocol": "vless",
    "settings": {
      "clients": [{"id": "{{ env.VLESS_UUID }}", "flow": "xtls-rprx-vision"}],
      "decryption": "none"
    },
    "streamSettings": {
      "network": "tcp",
      "security": "reality",
      "realitySettings": {
        "show": false,
        "dest": "{{ env.REALITY_DEST }}",
        "xver": 0,
        "serverNames": {{ env.REALITY_SERVER_NAMES_JSON }},
        "privateKey": "{{ env.REALITY_PRIVATE_KEY }}",
        "shortIds": ["{{ env.REALITY_SHORT_ID }}"]
      }
    }
  }],
  "outbounds": [{"protocol": "freedom", "tag": "direct"}]
}
