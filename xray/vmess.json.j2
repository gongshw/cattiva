{
  "log": { "loglevel": "warning" },
  "inbounds": [{
    "port": 4443,
    "protocol": "vmess",
    "settings": {
      "clients": [{"id": "{{ env.VMESS_UUID }}", "level": 1, "alterId": 0}]
    },
    "streamSettings": {
      "network": "ws",
      "security": "none",
      "wsSettings": {
        "path": "{{ env.VMESS_WS_PATH }}",
        "headers": {}
      }
    }
  }],
  "outbounds": [{"protocol": "freedom", "tag": "direct"}]
}
