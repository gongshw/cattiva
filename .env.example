# Domain
SITE_DOMAIN=0.gongshiwei.com

# ACME - Cloudflare DNS-01 challenge
ACME_EMAIL=your-email@example.com
CF_DNS_API_TOKEN=your-cloudflare-api-token

# VLESS+Reality - generate with: docker run --rm --entrypoint /usr/local/bin/xray ghcr.io/xtls/xray-core:latest x25519
VLESS_UUID=change-me-to-a-uuid
REALITY_PRIVATE_KEY=change-me
REALITY_PUBLIC_KEY=change-me
REALITY_SHORT_ID=6ba85179e30d4fc2
REALITY_DEST=www.apple.com:443
REALITY_SERVER_NAMES=www.apple.com, www.icloud.com

# VMess+WS+TLS
VMESS_UUID=another-uuid-for-vmess
VMESS_WS_PATH=/proxy/ws
VMESS_SERVER_NAMES=0.gongshiwei.com, cdn.gongshw.com
