# Domain
SITE_DOMAIN=your-domain.com

# ACME - Cloudflare DNS-01 challenge
ACME_EMAIL=your-email@example.com
CF_DNS_API_TOKEN=your-cloudflare-api-token

# VLESS+Reality
# Generate keys: docker run --rm --entrypoint /usr/local/bin/xray ghcr.io/xtls/xray-core:latest x25519
VLESS_UUID=change-me
REALITY_PRIVATE_KEY=change-me
REALITY_PUBLIC_KEY=change-me
REALITY_SHORT_ID=6ba85179e30d4fc2
REALITY_DEST=www.apple.com:443
REALITY_SERVER_NAMES=www.apple.com, www.icloud.com

# VMess+WS+TLS
VMESS_UUID=change-me-too
VMESS_WS_PATH=/proxy/ws

# Static site directory (path to your camouflage site)
WWW_DIR=./www
