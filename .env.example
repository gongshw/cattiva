# ═══════════════════════════════════════════
# Global Settings
# ═══════════════════════════════════════════

SITE_DOMAIN=your-domain.com

# Exposed ports (default 80, 443)
PORT_HTTP=80
PORT_HTTPS=443

# ACME (Let's Encrypt via Cloudflare DNS-01)
ACME_EMAIL=your-email@example.com
CF_DNS_API_TOKEN=your-cloudflare-api-token

# Static site directory (path to your camouflage site)
WWW_DIR=./www

# ═══════════════════════════════════════════
# VLESS + Reality
# ═══════════════════════════════════════════
#
# Generate keys:
#   docker run --rm --entrypoint /usr/local/bin/xray ghcr.io/xtls/xray-core:latest x25519
#
# Generate UUID:
#   docker run --rm --entrypoint /usr/local/bin/xray ghcr.io/xtls/xray-core:latest uuid

VLESS_UUID=change-me

REALITY_PRIVATE_KEY=change-me
REALITY_PUBLIC_KEY=change-me
REALITY_SHORT_ID=6ba85179e30d4fc2
REALITY_DEST=www.apple.com:443
REALITY_SERVER_NAMES=www.apple.com, www.icloud.com

# ═══════════════════════════════════════════
# VMess + TLS
# ═══════════════════════════════════════════
#
# TLS is terminated by Traefik (ACME). Xray receives plain WS.
# Certificate is managed automatically — no manual cert needed.

VMESS_UUID=change-me-too
VMESS_WS_PATH=/proxy/ws
