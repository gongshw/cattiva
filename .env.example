# ═══════════════════════════════════════════
# Ports
# ═══════════════════════════════════════════

PORT_HTTP=80
PORT_HTTPS=443

# ═══════════════════════════════════════════
# VLESS + Reality
# ═══════════════════════════════════════════
#
# Generate keys:
#   docker run --rm --entrypoint /usr/local/bin/xray ghcr.io/xtls/xray-core:latest x25519
#
# Generate UUID:
#   docker run --rm --entrypoint /usr/local/bin/xray ghcr.io/xtls/xray-core:latest uuid

VLESS_UUID=change-me

REALITY_PRIVATE_KEY=change-me
REALITY_PUBLIC_KEY=change-me
REALITY_SHORT_ID=change-me  # hex string, up to 16 chars. run: openssl rand -hex 8
REALITY_SERVER_NAME=cloudflare.com

# ═══════════════════════════════════════════
# VMess + TLS
# ═══════════════════════════════════════════
#
# TLS is terminated by Traefik (ACME via Cloudflare DNS-01).
# Xray receives plain WS. Certificate is managed automatically.

SITE_DOMAIN=your-domain.com
ACME_EMAIL=your-email@example.com
CF_DNS_API_TOKEN=your-cloudflare-api-token
VMESS_UUID=change-me-too
VMESS_WS_PATH=/proxy/ws
WWW_DIR=./www

# ═══════════════════════════════════════════
# Hysteria 2 (QUIC / UDP)
# ═══════════════════════════════════════════
#
# Hysteria 2 terminates TLS itself and never goes through Traefik:
# TCP 443 stays with Traefik, UDP 443 goes to the hysteria service.
#
# Generate the password with: openssl rand -base64 24
#
# HYSTERIA_DOMAIN  — domain the certificate is issued for. In ACME mode it
#                    must resolve to this host (a direct A record, not
#                    Cloudflare-proxied, because ACME DNS-01 needs the
#                    challenge to work but the proxy needs real UDP).
# HYSTERIA_TLS_MODE — "acme" (default) issues and renews the certificate
#                    automatically via Cloudflare DNS-01. "local" expects a
#                    PEM pair in HYSTERIA_CERT_DIR instead.

HYSTERIA_PASSWORD=change-me
HYSTERIA_DOMAIN=your-domain.com
HYSTERIA_PORT=443
HYSTERIA_PORT_HOST=443
HYSTERIA_TLS_MODE=acme

# Only used when HYSTERIA_TLS_MODE=local
HYSTERIA_CERT_DIR=./data/hysteria
HYSTERIA_CERT_FILE=cert.pem
HYSTERIA_KEY_FILE=key.pem
HYSTERIA_SNI_GUARD=dns-san

# Server-side speed limits (e.g. "300 mbps"). Leave empty to use the
# client's advertised bandwidth instead.
HYSTERIA_BANDWIDTH_UP=
HYSTERIA_BANDWIDTH_DOWN=

HYSTERIA_UDP_IDLE_TIMEOUT=60s
HYSTERIA_MASQUERADE_URL=http://static:80
