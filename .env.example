# ═══════════════════════════════════════════
# Ports
# ═══════════════════════════════════════════

PORT_HTTP=80
PORT_HTTPS=443

# ═══════════════════════════════════════════
# VLESS + Reality
# ═══════════════════════════════════════════
#
# Generate keys:
#   docker run --rm --entrypoint /usr/local/bin/xray ghcr.io/xtls/xray-core:latest x25519
#
# Generate UUID:
#   docker run --rm --entrypoint /usr/local/bin/xray ghcr.io/xtls/xray-core:latest uuid

VLESS_UUID=change-me

REALITY_PRIVATE_KEY=change-me
REALITY_PUBLIC_KEY=change-me
REALITY_SHORT_ID=change-me  # hex string, up to 16 chars. run: openssl rand -hex 8
REALITY_SERVER_NAME=cloudflare.com

# ═══════════════════════════════════════════
# VMess + TLS
# ═══════════════════════════════════════════
#
# TLS is terminated by Traefik (ACME via Cloudflare DNS-01).
# Xray receives plain WS. Certificate is managed automatically.

SITE_DOMAIN=your-domain.com
ACME_EMAIL=your-email@example.com
CF_DNS_API_TOKEN=your-cloudflare-api-token
VMESS_UUID=change-me-too
VMESS_WS_PATH=/proxy/ws
WWW_DIR=./www

# ═══════════════════════════════════════════
# Hysteria 2 (QUIC / UDP)
# ═══════════════════════════════════════════
#
# Hysteria 2 terminates TLS itself and never goes through Traefik:
# TCP 443 stays with Traefik, UDP 443 goes to xray-hysteria.
#
# The certificate directory is mounted read-only into the container.
# Put cert.pem / key.pem there, or point HYSTERIA_CERT_DIR at your own path.
#
# The client pins the server certificate by SHA-256 of its DER bytes:
#   openssl x509 -in cert.pem -outform DER | sha256sum
#
# Generate the password with: openssl rand -base64 24

HYSTERIA_PASSWORD=change-me
HYSTERIA_PORT=443
HYSTERIA_PORT_HOST=443
HYSTERIA_CERT_DIR=./data/hysteria
HYSTERIA_CERT_FILE=cert.pem
HYSTERIA_KEY_FILE=key.pem
HYSTERIA_UDP_IDLE_TIMEOUT=60
