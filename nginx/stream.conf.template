# TCP stream - SNI-based routing
stream {
    map $ssl_preread_server_name $backend {
        ${REALITY_MAP_RULES}
        default 127.0.0.1:8443;
    }

    upstream xray-reality {
        server xray-reality:4433;
    }

    server {
        listen 443;
        ssl_preread on;
        proxy_pass $backend;
    }
}
