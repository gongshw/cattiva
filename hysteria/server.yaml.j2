# Hysteria 2 server config — generated by config-gen, do not edit.
#
# Hysteria 2 speaks QUIC/UDP and terminates TLS itself, so it bypasses
# Traefik entirely. Traefik keeps TCP 443; this service owns UDP 443.
# Both can use port 443 because TCP and UDP are separate protocol spaces.

listen: :{{ env.PORT_HTTPS }}

# ACME DNS-01 certificate, issued and renewed automatically. The DNS
# provider token is read from the environment at generation time and is
# never committed to this repository.
#
# SITE_DOMAIN must resolve to this host with a direct, unproxied DNS
# record: QUIC cannot traverse a Cloudflare proxy.
acme:
  domains:
    - "{{ env.SITE_DOMAIN }}"
  email: {{ env.ACME_EMAIL }}
  ca: letsencrypt
  type: dns
  dir: /acme
  dns:
    name: cloudflare
    config:
      cloudflare_api_token: {{ env.CF_DNS_API_TOKEN }}

auth:
  type: password
  password: "{{ env.HYSTERIA_PASSWORD }}"

udpIdleTimeout: 60s

# Serve the static camouflage site for plain HTTP requests that reach the
# QUIC port, so the endpoint looks like an ordinary website. It proxies
# back to this host's own HTTPS site.
masquerade:
  type: proxy
  proxy:
    url: https://{{ env.SITE_DOMAIN }}
    rewriteHost: true
