# Hysteria 2 server config — generated by config-gen, do not edit.
#
# Hysteria 2 speaks QUIC/UDP and terminates TLS itself, so it bypasses
# Traefik entirely. Traefik keeps TCP 443; this service owns UDP 443.
# Both can use port 443 because TCP and UDP are separate protocol spaces.

listen: :{{ env.HYSTERIA_PORT | default(443) }}

{% if env.HYSTERIA_TLS_MODE | default('acme') == 'local' %}
# Local certificate mode: bring your own PEM pair.
# Useful for testing and for deployments that manage certs outside this stack.
tls:
  cert: /etc/hysteria-certs/{{ env.HYSTERIA_CERT_FILE | default('cert.pem') }}
  key: /etc/hysteria-certs/{{ env.HYSTERIA_KEY_FILE | default('key.pem') }}
  sniGuard: {{ env.HYSTERIA_SNI_GUARD | default('dns-san') }}
{% else %}
# ACME DNS-01 mode: certificates are issued and renewed automatically.
# The DNS provider token is read from the environment at generation time and
# is never committed to this repository.
acme:
  domains:
    - "{{ env.HYSTERIA_DOMAIN }}"
  email: {{ env.ACME_EMAIL }}
  ca: letsencrypt
  type: dns
  dir: {{ env.HYSTERIA_ACME_DIR | default('/acme') }}
  dns:
    name: cloudflare
    config:
      cloudflare_api_token: {{ env.CF_DNS_API_TOKEN }}
{% endif %}

auth:
  type: password
  password: "{{ env.HYSTERIA_PASSWORD }}"

{% if env.HYSTERIA_BANDWIDTH_UP %}
bandwidth:
  up: {{ env.HYSTERIA_BANDWIDTH_UP }}
  down: {{ env.HYSTERIA_BANDWIDTH_DOWN | default(env.HYSTERIA_BANDWIDTH_UP) }}
{% endif %}

udpIdleTimeout: {{ env.HYSTERIA_UDP_IDLE_TIMEOUT | default('60s') }}

# Serve the static camouflage site for plain HTTP requests that reach the
# QUIC port. Keeps the endpoint looking like an ordinary website.
masquerade:
  type: proxy
  proxy:
    url: {{ env.HYSTERIA_MASQUERADE_URL | default('http://static:80') }}
    rewriteHost: true
