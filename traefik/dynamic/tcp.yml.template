# TCP routing - SNI-based passthrough
# Generated by config-gen

tcp:
  routers:
    reality:
      rule: "${REALITY_SNI}"
      entryPoints:
        - websecure
      service: xray-reality
      tls:
        passthrough: true

    vmess:
      rule: "${VMESS_SNI}"
      entryPoints:
        - websecure
      service: xray-vmess
      tls:
        passthrough: true

  services:
    xray-reality:
      loadBalancer:
        servers:
          - address: xray-reality:4433

    xray-vmess:
      loadBalancer:
        servers:
          - address: xray-vmess:4443
