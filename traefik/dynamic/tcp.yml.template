# Traefik dynamic config - generated by config-gen

# TCP routing - passthrough for Reality
tcp:
  routers:
    reality:
      rule: "HostSNI(\`${REALITY_SNI}\`)"
      entryPoints:
        - websecure
      service: xray-reality
      tls:
        passthrough: true

  services:
    xray-reality:
      loadBalancer:
        servers:
          - address: xray-reality:4433


# HTTP routing - VMess WS proxy + static site
http:
  routers:
    vmess-ws:
      rule: "${VMESS_HTTP_RULE} && PathPrefix(\`${VMESS_WS_PATH}\`)"
      entryPoints:
        - websecure
      service: xray-vmess
      tls:
        certResolver: cloudflare

    static-site:
      rule: "${VMESS_HTTP_RULE}"
      entryPoints:
        - websecure
      service: static-server
      tls:
        certResolver: cloudflare

  services:
    xray-vmess:
      loadBalancer:
        servers:
          - address: xray-vmess:4443

    static-server:
      loadBalancer:
        servers:
          - address: static:80
