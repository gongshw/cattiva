# TCP routing - SNI-based passthrough
# Generated by setup.sh

tcp:
  routers:
    reality:
      rule: "HostSNI(\`${REALITY_SNI_PATTERN}\`)"
      entryPoints:
        - websecure
      service: xray-reality
      tls:
        passthrough: true

    vmess:
      rule: "HostSNI(\`${VMESS_SNI_PATTERN}\`)"
      entryPoints:
        - websecure
      service: xray-vmess
      tls:
        passthrough: true

  services:
    xray-reality:
      loadBalancer:
        servers:
          - address: xray-reality:4433

    xray-vmess:
      loadBalancer:
        servers:
          - address: xray-vmess:4443
