# HTTP routing - VMess WS proxy + static site

{%- macro host_rule(domains) -%}
{%- set ns = namespace(parts=[]) -%}
{%- for d in domains.replace(',', ' ').split() -%}
{%- set d = d.strip() -%}
{%- if d -%}
{%- set ns.parts = ns.parts + ['Host(`' ~ d ~ '`)'] -%}
{%- endif -%}
{%- endfor -%}
{{ ns.parts | join(' || ') }}
{%- endmacro -%}

http:
  routers:
    vmess-ws:
      rule: '{{ host_rule(env.SITE_DOMAIN) }} && PathPrefix(`{{ env.VMESS_WS_PATH }}`)'
      entryPoints:
        - websecure
      service: xray-vmess
      tls:
        certResolver: cloudflare

    static-site:
      rule: '{{ host_rule(env.SITE_DOMAIN) }}'
      entryPoints:
        - websecure
      service: static-server
      tls:
        certResolver: cloudflare

{% if env.SITE_ALIASES %}
{% for alias in env.SITE_ALIASES.split(',') %}
{% set a = alias.strip() %}
    cdn-{{ a }}:
      rule: 'Host(`{{ a }}`)'
      entryPoints:
        - websecure
      service: static-server
      tls: {}

    cdn-ws-{{ a }}:
      rule: 'Host(`{{ a }}`) && PathPrefix(`{{ env.VMESS_WS_PATH }}`)'
      entryPoints:
        - websecure
      service: xray-vmess
      tls: {}
{% endfor %}
{% endif %}

  services:
    xray-vmess:
      loadBalancer:
        servers:
          - url: "http://xray-vmess:4443"

    static-server:
      loadBalancer:
        servers:
          - url: "http://static:80"
