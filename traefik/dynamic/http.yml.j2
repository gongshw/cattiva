# HTTP routing - VMess WS proxy + static site

http:
  routers:
    vmess-ws:
      rule: '{{ env.VMESS_HTTP_RULE }} && PathPrefix(`{{ env.VMESS_WS_PATH }}`)'
      entryPoints:
        - websecure
      service: xray-vmess
      tls:
        certResolver: cloudflare

    static-site:
      rule: '{{ env.VMESS_HTTP_RULE }}'
      entryPoints:
        - websecure
      service: static-server
      tls:
        certResolver: cloudflare

{% for alias in env.SITE_ALIASES_LIST %}
    cdn-{{ alias }}:
      rule: 'Host(`{{ alias }}`)'
      entryPoints:
        - websecure
      service: static-server
      tls: {}

    cdn-ws-{{ alias }}:
      rule: 'Host(`{{ alias }}`) && PathPrefix(`{{ env.VMESS_WS_PATH }}`)'
      entryPoints:
        - websecure
      service: xray-vmess
      tls: {}
{% endfor %}

  services:
    xray-vmess:
      loadBalancer:
        servers:
          - url: "http://xray-vmess:4443"

    static-server:
      loadBalancer:
        servers:
          - url: "http://static:80"
