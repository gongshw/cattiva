# Traefik dynamic config - generated by config-gen

# TCP routing - passthrough for Reality
tcp:
  routers:
    reality:
      rule: 'HostSNI(`{{ env.REALITY_SERVER_NAME }}`)'
      entryPoints:
        - websecure
      service: xray-reality
      priority: 100
      tls:
        passthrough: true

    reject-nosni:
      rule: 'HostSNIRegexp(`{domain:^$}`)'
      entryPoints:
        - websecure
      service: blackhole
      priority: 10
      tls:
        passthrough: true

    reject-unknown:
      rule: 'HostSNIRegexp(`{domain:.+}`)'
      entryPoints:
        - websecure
      service: blackhole
      priority: 1
      tls:
        passthrough: true

  services:
    xray-reality:
      loadBalancer:
        servers:
          - address: "xray-reality:4433"

    blackhole:
      loadBalancer:
        servers:
          - address: "127.0.0.1:1"
