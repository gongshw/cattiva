# Traefik dynamic config - generated by config-gen

# TCP routing - passthrough for Reality
tcp:
  routers:
    reality:
      rule: 'HostSNI(`{{ env.REALITY_SERVER_NAME }}`)'
      entryPoints:
        - websecure
      service: xray-reality
      tls:
        passthrough: true

  services:
    xray-reality:
      loadBalancer:
        servers:
          - address: "xray-reality:4433"
